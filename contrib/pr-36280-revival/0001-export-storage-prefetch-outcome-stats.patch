+    @staticmethod
+    def _storage_metrics(prefetch_stats):
+        metrics = StorageMetrics()
+        metrics.prefetch_stats = prefetch_stats
+        return metrics
+
+    @staticmethod
+    def _outcome_totals(metric):
+        totals = {}
+        for metric_labels, value in metric.increments:
+            outcome = metric_labels["outcome"]
+            totals[outcome] = totals.get(outcome, 0) + value
+        return totals
+
+    def test_storage_prefetch_outcomes_export_monotonic_deltas(self):
+        labels = {"model_name": "test"}
+        collector = _RecordingStorageMetricsCollector(labels=labels)
+
+        first = {"attempts": 2, "issued": 1, "revoked_full_miss": 1}
+        collector.log_storage_metrics(self._storage_metrics(first))
+        # A repeated identical flush must not double-count.
+        collector.log_storage_metrics(self._storage_metrics(first))
+
+        collector.log_storage_metrics(
+            self._storage_metrics(
+                {
+                    "attempts": 3,
+                    "issued": 2,
+                    "declined_rate_limited": 1,
+                    "revoked_full_miss": 1,
+                }
+            )
+        )
+        # A lower snapshot (the cache reset its counters while the collector
+        # survived) starts a new epoch: re-export the current value, never a
+        # negative delta.
+        collector.log_storage_metrics(
+            self._storage_metrics({"attempts": 1, "issued": 1})
+        )
+
+        totals = self._outcome_totals(collector.storage_prefetch_outcome_events_total)
+        self.assertEqual(totals["attempts"], 4)
+        self.assertEqual(totals["issued"], 3)
+        self.assertEqual(totals["declined_rate_limited"], 1)
+        self.assertEqual(totals["revoked_full_miss"], 1)
+
+    def test_storage_prefetch_outcomes_follow_snapshot_keys(self):
+        # The collector must not enumerate outcomes: every key of the cache's
+        # _prefetch_outcome_stats snapshot exports as it appears, including
+        # keys that postdate this test.
+        labels = {"model_name": "test"}
+        collector = _RecordingStorageMetricsCollector(labels=labels)
+
+        collector.log_storage_metrics(
+            self._storage_metrics(
+                {
+                    "issued_assumed_stored": 2,
+                    "declined_anchor_lost": 1,
+                    "declined_device_covered": 1,
+                    "declined_host_oversize": 1,
+                    "declined_unservable_prefix": 1,
+                    "revoked_insufficient": 3,
+                    "l3_demand_requests": 5,
+                }
+            )
+        )
+
+        self.assertEqual(
+            self._outcome_totals(collector.storage_prefetch_outcome_events_total),
+            {
+                "issued_assumed_stored": 2,
+                "declined_anchor_lost": 1,
+                "declined_device_covered": 1,
+                "declined_host_oversize": 1,
+                "declined_unservable_prefix": 1,
+                "revoked_insufficient": 3,
+                "l3_demand_requests": 5,
+            },
+        )
+        self.assertEqual(
+            collector.storage_prefetch_outcome_tokens_total.increments, []
+        )
+
+    def test_storage_prefetch_outcomes_route_token_denominated_keys(self):
+        # Suffix routing keeps units off the event counter: *_tokens keys are
+        # request-demand token totals, not prefetch events.
+        labels = {"model_name": "test"}
+        collector = _RecordingStorageMetricsCollector(labels=labels)
+
+        collector.log_storage_metrics(
+            self._storage_metrics(
+                {"attempts": 1, "l3_miss_tokens": 700, "l1l2_miss_tokens": 900}
+            )
+        )
+
+        self.assertEqual(
+            self._outcome_totals(collector.storage_prefetch_outcome_events_total),
+            {"attempts": 1},
+        )
+        self.assertEqual(
+            self._outcome_totals(collector.storage_prefetch_outcome_tokens_total),
+            {"l3_miss_tokens": 700, "l1l2_miss_tokens": 900},
+        )
+
+    def test_storage_prefetch_outcomes_skip_missing_stats(self):
+        labels = {"model_name": "test"}
+        collector = _RecordingStorageMetricsCollector(labels=labels)
+
+        # prefetch_stats defaults to None: no radix cache behind the reporter.
+        collector.log_storage_metrics(StorageMetrics())
+        # A legacy StorageMetrics from before the field was declared has no
+        # attribute to read; both must be a no-op, not an error.
+        legacy = StorageMetrics()
+        del legacy.prefetch_stats
+        collector.log_storage_metrics(legacy)
+
+        self.assertEqual(
+            collector.storage_prefetch_outcome_events_total.increments, []
+        )
+        self.assertEqual(
+            collector.storage_prefetch_outcome_tokens_total.increments, []
+        )
+
 
