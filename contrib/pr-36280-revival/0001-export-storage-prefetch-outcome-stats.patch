+    def log_prefetch_outcomes(self, prefetch_stats: Mapping[str, float]) -> None:
+        """Export cumulative cache-side prefetch-outcome counters.
+
+        UnifiedRadixCache owns the counters and may reset them while this
+        collector survives (e.g. a storage detach/reattach). A lower snapshot
+        therefore starts a new epoch: export its current value, never a
+        negative delta. Outcomes are not enumerated here — every snapshot key
+        is an `outcome` label, routed by unit (the *_tokens suffix to the
+        token counter, everything else to the event counter) so a new cache
+        side outcome needs no collector change.
+        """
+        for outcome, current_value in prefetch_stats.items():
+            current = max(float(current_value), 0.0)
+            previous = self._last_prefetch_outcome_stats.get(outcome, 0.0)
+            increment = current if current < previous else current - previous
+            if increment > 0:
+                if outcome.endswith("_tokens"):
+                    counter = self.storage_prefetch_outcome_tokens_total
+                else:
+                    counter = self.storage_prefetch_outcome_events_total
+                counter.labels(**self.labels, outcome=outcome).inc(increment)
+            # Retain the last seen value for keys that vanish from the
+            # snapshot too: pruning here would re-export the full counter
+            # from zero if the key later reappears with a higher value.
+            self._last_prefetch_outcome_stats[outcome] = current
+
     def log_prefetched_tokens(self, prefetched_tokens: int):
         if prefetched_tokens > 0:
             self.prefetched_tokens_total.labels(**self.labels).inc(prefetched_tokens)
@@ -2493,6 +2558,11 @@ class StorageMetricsCollector(_StatLoggerDIMixin):
             self._log_histogram(self.histogram_prefetch_bandwidth, v)
         for v in storage_metrics.backup_bandwidth:
             self._log_histogram(self.histogram_backup_bandwidth, v)
+        # Attached by the check_hicache_events feed; stays None (or absent on
+        # a legacy StorageMetrics) when no radix cache backs this reporter.
+        prefetch_stats = getattr(storage_metrics, "prefetch_stats", None)
+        if prefetch_stats:
+            self.log_prefetch_outcomes(prefetch_stats)
 
 
